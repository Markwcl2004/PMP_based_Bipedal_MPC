// PMPOptimizer.cc - Pontryagin-based optimizer (FBDE + superlinear iteration)

#include "generation/PMPOptimizer.h"
#include <iostream>

namespace clear {

PMPOptimizer::PMPOptimizer(const std::vector<OcpStage>& ocp, size_t nx, size_t nu)
    : ocp_(ocp), nx_(nx), nu_(nu), N_(ocp.size() - 1) {}

void PMPOptimizer::setInitialState(const vector_t& x0) {
  x0_ = x0;
}

/*
  Attention!!!
  "stagep[k].lamda" means that lamda_{k+1} in the essay (k = 0, ..., N)

*/

void PMPOptimizer::initializeTrajectory() {
  stages_.clear();
  stages_.resize(N_ + 1);
  for (size_t k = 0; k <= N_; ++k) {
    stages_[k].x = (k == 0 ? x0_ : vector_t::Zero(nx_));
    stages_[k].u = vector_t::Zero(nu_);
    stages_[k].lambda = vector_t::Zero(nx_);  // lamda_{N+1} = 0
  }
}

void PMPOptimizer::forwardSimulate() {
  for (size_t k = 0; k < N_; ++k) {
    const auto& A = ocp_[k].A;
    const auto& B = ocp_[k].B;
    const auto& b = ocp_[k].b;
    stages_[k + 1].x = A * stages_[k].x + B * stages_[k].u + b;
  }
}

void PMPOptimizer::backwardCostate() {
  stages_[N_].lambda.setZero();  // 终点 λ_N = 0
  stages_[N_].P = Eigen::MatrixXd::Zero(nx_, nx_);
  stages_[N_].p = Eigen::VectorXd::Zero(nx_);

  for (int k = N_ - 1; k >= 0; --k) {
    const auto& A = ocp_[k].A;
    const auto& B = ocp_[k].B;
    
    // const auto& Q = ocp_[k + 1].Q;
    const auto& Q = ocp_[k].Q;
    const auto& R = ocp_[k].R;
    // const auto& q = ocp_[k + 1].q;
    const auto& q = ocp_[k].q;
    const auto& r = ocp_[k].r;


    if (k-1 >= 0){
      stages_[k-1].lambda = (Q + Q.transpose()) * stages_[k].x 
                            + q + A.transpose() * stages_[k].lambda;
    }
    
  }
}

    // const auto& P_next = stages_[k + 1].P;
    // const auto& p_next = stages_[k + 1].p;

    // // 中间变量
    // matrix_t G = R + B.transpose() * P_next * B;
    // matrix_t G_inv = G.ldlt().solve(Eigen::MatrixXd::Identity(nu_, nu_));
    // matrix_t BT_P_A = B.transpose() * P_next * A;

    // // 反馈增益 & 前馈项
    // matrix_t K = G_inv * BT_P_A;
    // vector_t k_ff = G_inv * (B.transpose() * p_next + r);

    // // 保存
    // stages_[k].K = K;
    // stages_[k].k = -k_ff;

    // 代价项递推
    // stages_[k].P = Q + A.transpose() * P_next * (A - B * K);
    // stages_[k].p = q + A.transpose() * (p_next - P_next * B * k_ff);


    // lamda_k = (Q_k + Q_K^T) * x_k + q_k + A_k^T * lamda_{k+1}



vector_t PMPOptimizer::computeGradient() {
    // 一阶 J 计算公式 = (R + R^T) * u_k + r + B^T * lambda_{k+1};
    std::cout << "[PMPOptimizer] gradient compute begin" << "\n";

    assert(ocp_.size() == N_ + 1); // 确保 ocp_ 的大小正确
    assert(stages_.size() == N_ + 1); // 确保 stages_ 的大小正确
    std::cout << "[PMPOptimizer] N_ = " << N_ << ", nu_ = " << nu_ << ", nx_ = " << nx_ << "\n";

    const double rho = 1000.0;  // 惩罚权重   5.11
    vector_t grad = vector_t::Zero((N_ + 1) * nu_);

    std::cout << "[PMPOptimizer] grad size = " << grad.size() << "\n";


    for (size_t k = 0; k < N_; ++k) {
        const auto& R = ocp_[k].R;
        const auto& r = ocp_[k].r;
        const auto& B = ocp_[k].B;

        // 这里的grad是一个按 k*nu_ 索引的列向量序列
        grad.segment(k * nu_, nu_) = (R + R.transpose()) * stages_[k].u 
                                      + r + B.transpose() * stages_[k].lambda;

        /// <<< 防止空约束导致段错误 5.11
        if (ocp_[k].C.size() == 0 || ocp_[k].D.size() == 0 ||
            ocp_[k].lg.size() == 0 || ocp_[k].ug.size() == 0) {
          continue;
        }

        std::cout << "Using C, D" << k << "\n";

        const auto& C = ocp_[k].C;
        const auto& D = ocp_[k].D;
        const auto& lg = ocp_[k].lg;
        const auto& ug = ocp_[k].ug;

        if (R.rows() != nu_ || R.cols() != nu_) {
            std::cerr << "Error: R size mismatch. Expected (" << nu_ << ", " << nu_ << "), got (" << R.rows() << ", " << R.cols() << ")" << std::endl;
        }
        if (r.size() != nu_) {
            std::cerr << "Error: r size mismatch. Expected " << nu_ << ", got " << r.size() << std::endl;
        }
        if (B.rows() != nx_ || B.cols() != nu_) {
            std::cerr << "Error: B size mismatch. Expected (" << nx_ << ", " << nu_ << "), got (" << B.rows() << ", " << B.cols() << ")" << std::endl;
        }
        if (stages_[k].u.size() != nu_) {
            std::cerr << "Error: u size mismatch. Expected " << nu_ << ", got " << stages_[k].u.size() << std::endl;
        }
        if (stages_[k].lambda.size() != nx_) {
            std::cerr << "Error: lambda size mismatch. Expected " << nx_ << ", got " << stages_[k].lambda.size() << std::endl;
        }

        if (k * nu_ + nu_ > grad.size()) {
            std::cerr << "Error: grad segment out of bounds. k = " << k << ", nu_ = " << nu_ << ", grad size = " << grad.size() << std::endl;
        }

        
        // 不等式惩罚项  5.11
        vector_t gk = C * stages_[k].x + D * stages_[k].u;
        vector_t delta_ug = gk - ug;
        vector_t delta_lg = lg - gk;

        delta_ug = delta_ug.cwiseMax(0.0);  // 违背上界的部分  5.11
        delta_lg = delta_lg.cwiseMax(0.0);  // 违背下界的部分  5.11

        grad.segment(k * nu_, nu_) += rho * D.transpose() * (delta_ug - delta_lg);  //  5.11
    }

    std::cout << "[PMPOptimizer] gradient norm = " << grad.norm() << "\n";
    std::cout << "[PMPOptimizer] gradient compute end" << "\n";
    return grad;
}




// compute beta_k^i based on the index i (column of the Hessian)

vector_t PMPOptimizer::computeBetaTerm(size_t k, size_t i) const {
    size_t nx = nx_;
    size_t N = N_;

    std::vector<vector_t> beta(N + 1, vector_t::Zero(nx));
    beta[N] = vector_t::Zero(nx);  // β_{N} = 0 terminal

    for (int j = static_cast<int>(N) - 1; j >= static_cast<int>(k); --j) {
        const auto& A = ocp_[j].A;
        const auto& B = ocp_[j].B;

        if (A.rows() != nx || A.cols() != nx) {
            std::cerr << "[beta] A[" << j << "] size mismatch: " 
            << A.rows() << "x" << A.cols() << std::endl;
        }
        if (B.rows() != nx || B.cols() != nu_) {
            std::cerr << "[beta] B[" << j << "] size mismatch: " 
            << B.rows() << "x" << B.cols() << std::endl;
        }

        if (j == static_cast<int>(i)) {
            beta[j] = B + A.transpose() * beta[j + 1];
        } else {
            beta[j] = A.transpose() * beta[j + 1];
        }
    }

    return beta[k];
}

// compute alpha_k^i based on the index i (column of the Hessian)

vector_t PMPOptimizer::computeAlphaTerm(size_t k, size_t i) const {
    size_t nx = nx_;
    size_t N = N_;

    std::vector<vector_t> alpha(N + 1, vector_t::Zero(nx));
    alpha[N] = vector_t::Zero(nx);  // α_{N} = 0 terminal

    for (int j = static_cast<int>(N) - 1; j >= static_cast<int>(k); --j) {
        const auto& A = ocp_[j].A;
        const auto& Q = ocp_[j].Q;
        const matrix_t Qt = Q + Q.transpose();
        const vector_t beta_j = computeBetaTerm(j, i);

        if (A.rows() != nx || A.cols() != nx) {
            std::cerr << "[alpha] A[" << j << "] size mismatch: " 
            << A.rows() << "x" << A.cols() << std::endl;
        }
        if (Q.rows() != nx || Q.cols() != nx) {
            std::cerr << "[alpha] Q[" << j << "] size mismatch: " 
            << Q.rows() << "x" << Q.cols() << std::endl;
        }

        alpha[j] = A.transpose() * alpha[j + 1] + Qt * beta_j;
    }

    return alpha[k];
}

// New version of computeHessian using full structure (without approximation)

matrix_t PMPOptimizer::computeHessian() {
    const size_t nx = nx_;
    const size_t nu = nu_;
    const size_t N = N_;
    matrix_t H = matrix_t::Zero(N * nu, N * nu);

    std::cout << "[PMPOptimizer] computeHessian begin\n";

    for (size_t i = 0; i < N; ++i) {
        for (size_t k = 0; k < N; ++k) {
            std::cout << "[PMPOptimizer] i=" << i << ", k=" << k << "\n";

            std::cout << "[PMPOptimizer] computeBetaTerm begin\n";
            vector_t beta_k_i = computeBetaTerm(k, i);
            std::cout << "[PMPOptimizer] computeBetaTerm end\n";

            std::cout << "[PMPOptimizer] computeAlphaTerm begin\n";
            const vector_t alpha_k1_i = computeAlphaTerm(k + 1, i); // α_{k+1}^i
            std::cout << "[PMPOptimizer] computeAlphaTerm end\n";


            const matrix_t term = ocp_[k].B.transpose() * alpha_k1_i;  // (nu x 1)

            if (i == k) {
                H.block(i * nu, k * nu, nu, nu) = (ocp_[k].R + ocp_[k].R.transpose());
            } else {
                H.block(i * nu, k * nu, nu, nu).setZero(); // 初始化为0
            }

            H.block(i * nu, k * nu, nu, nu) += term * beta_k_i.head(nu).transpose(); 
        }
    }

    std::cout << "[PMPOptimizer] computeHessian end\n";
    return H;
}



