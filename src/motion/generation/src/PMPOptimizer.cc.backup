void PMPOptimizer::updateControl(const vector_t& g) {
  for (size_t k = 0; k <= N_; ++k) {
    if (k * nu_ + nu_ > static_cast<size_t>(g.size())) { // 越界防御
      std::cerr << "Control更新越界! k=" << k << "\n";
      break;
    }
    stages_[k].u -= g.segment(k * nu_, nu_);
  }
}

bool PMPOptimizer::solve(std::vector<OcpSolution>& solution_out) {
  std::cout << "[PMPOptimizer] solve() called\n";

  initializeTrajectory();
  std::cout << "[PMPOptimizer] initialized trajectory\n";

  forwardSimulate();
  std::cout << "[PMPOptimizer] forward simulated\n";

  backwardCostate();
  std::cout << "[PMPOptimizer] backward costate computed\n";

  vector_t grad = computeGradient();
  if(grad.norm() > 1e6) { // 异常梯度阈值
    std::cerr << "Grad Boom! norm=" << grad.norm() << "\n";
    return false;
  }
  std::cout << "[PMPOptimizer] gradient norm = " << grad.norm() << "\n";

  matrix_t hess = computeHessian();
  std::cout << "[PMPOptimizer] hessian size = " << hess.rows() << "x" << hess.cols() << "\n";
  
  vector_t update = superlinearUpdate(grad, hess);
  std::cout << "[PMPOptimizer] computed update direction\n";

  updateControl(update);
  std::cout << "[PMPOptimizer] control updated\n";

  solution_out.resize(N_ + 1);
  for (size_t i = 0; i <= N_; ++i) {
    solution_out[i].x = stages_[i].x;
    solution_out[i].u = stages_[i].u;

    // 协态（costate）
    solution_out[i].pi = stages_[i].lambda;

    // Riccati矩阵 P 和向量 p
    solution_out[i].P = Eigen::MatrixXd::Identity(nx_, nx_);
    solution_out[i].p = Eigen::VectorXd::Zero(nx_);

    // 控制反馈结构
    solution_out[i].K = Eigen::MatrixXd::Zero(nu_, nx_);
    solution_out[i].k = Eigen::VectorXd::Zero(nu_);
  }
  

  std::cout << "[PMPOptimizer] solution success\n";
  return true;
}

} // namespace clear