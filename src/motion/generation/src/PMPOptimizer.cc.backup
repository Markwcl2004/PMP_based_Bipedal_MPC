vector_t PMPOptimizer::superlinearUpdate(const vector_t& grad, const matrix_t& hess) {
  std::cout << "[PMPOptimizer] superlinearUpdate begin\n";

  const size_t N = N_;
  const size_t nu = nu_;
  const size_t dim = (N + 1) * nu;
  const int max_iters = 10;  // 可调超线性迭代次数
  const double epsilon = 1e-8;

  // 构造 block 对角矩阵 R_big = diag(R_0, ..., R_N)
  std::cout << "[superlinearUpdate] Diagnal R construction begin\n";
  matrix_t R_big = matrix_t::Zero(dim, dim);
  for (size_t k = 0; k <= N-1; ++k) {
    std::cout << "[superlinearUpdate] Diagnal R construction" << k <<" begin\n";
    R_big.block(k * nu, k * nu, nu, nu) = ocp_[k].R;
  }
  std::cout << "[superlinearUpdate] Diagnal R construction end\n";

  // 构造 H_aug = R + ∇²J
  std::cout << "[superlinearUpdate] Diagnal H_aug construction begin\n";
  matrix_t H_aug = R_big + hess + epsilon * matrix_t::Identity(hess.rows(), hess.cols());
  std::cout << "[superlinearUpdate] Diagnal H_aug construction end\n";

  // 确保对称
  H_aug = 0.5 * (H_aug + H_aug.transpose());

  // 使用 Cholesky 分解求解
  Eigen::LLT<matrix_t> llt(H_aug);
  if (llt.info() != Eigen::Success) {
    std::cerr << "[PMPOptimizer] Hessian 矩阵无法 Cholesky 分解!\n";
    return vector_t::Zero(grad.size());
  }

  // 初始化 g_0 = - (R + Hess)^{-1} * grad
  vector_t g = llt.solve(-grad);

  // 5. 超线性迭代: g_j = (R + Hess)^{-1} * [ ∇J + R * g_{j-1}]
  for (int j = 0; j < max_iters; ++j) {
    g = llt.solve(grad + R_big * g);
  }

  std::cout << "[PMPOptimizer] superlinearUpdate end\n";
  return g;
}

